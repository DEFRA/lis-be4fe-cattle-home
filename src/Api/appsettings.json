{
  "Cache": {
    "DurationMinutes": 5
  },
  "ApiKeyAuthentication": {
    "Keys": []
  },
  "CattleApi": {
    "BaseUrl": "",
    "ApiKey": "",
    "GetHoldingDetailsTimeout": 60000,
    "SearchHoldingsTimeout": 60000,
    "SearchCattleTimeout": 60000,
    "GetCattleDetailsTimeout": 60000,
    "GetUserDetailsTimeout": 60000,
    "CreateUserTimeout": 60000
  },
  "Mongo": {
    "DatabaseUri": "mongodb://set-automatically-when-deployed/admin?authSource=$external&authMechanism=MONGODB-AWS",
    "DatabaseName": "lis-be4fe-cattle-home"
  },
  "AllowedHosts": "*",
  "TraceHeader": "x-cdp-request-id",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Elastic.CommonSchema.Serilog.EcsTextFormatter, Elastic.CommonSchema.Serilog"
        }
      }
    ]
  }
}
