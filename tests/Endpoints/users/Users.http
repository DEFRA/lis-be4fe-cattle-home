### Create or refresh a user account (lis-fake-service keeps accounts in memory, so run this before the GET)
POST {{host}}/api/users
x-api-key: {{apiKey}}
x-cdp-request-id: {{$guid}}
Content-Type: application/json
Accept: application/json

{
  "sub": "{{subject}}",
  "email": "contact@test.com",
  "given_name": "FirstName",
  "family_name": "LastName"
}

> ../asserts/Should_be_200_OK.js

### Create a user account (missing email)
POST {{host}}/api/users
x-api-key: {{apiKey}}
x-cdp-request-id: {{$guid}}
Content-Type: application/json
Accept: application/json

{
  "sub": "{{subject}}",
  "given_name": "FirstName",
  "family_name": "LastName"
}

> ../asserts/Should_be_400_bad_request.js

### Create a user account (email already bound to another subject)
POST {{host}}/api/users
x-api-key: {{apiKey}}
x-cdp-request-id: {{$guid}}
Content-Type: application/json
Accept: application/json

{
  "sub": "{{$uuid}}",
  "email": "contact@test.com",
  "given_name": "FirstName",
  "family_name": "LastName"
}

> ../asserts/Should_be_409_conflict.js

### Get user details
GET {{host}}/api/users/{{subject}}
x-api-key: {{apiKey}}
x-cdp-request-id: {{$guid}}
Accept: application/json

> ../asserts/Should_be_200_OK.js

### Get user details (unknown subject)
GET {{host}}/api/users/00000000-0000-4000-8000-000000000000
x-api-key: {{apiKey}}
x-cdp-request-id: {{$guid}}
Accept: application/json

> ../asserts/Should_be_404.js

### Get CPHs for a user (still read from src/Api/Fixtures/CattleApi/cattle.json, not the cattle API)
GET {{host}}/api/users/{{fixtureUserId}}/cphs
x-api-key: {{apiKey}}
x-cdp-request-id: {{$guid}}
Accept: application/json

> ../asserts/Should_be_200_OK.js
